{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/davidmariscalf/CrisisWeave/schema/event.schema.json",
  "title": "CrisisWeaveEvent",
  "type": "object",
  "required": ["id", "kind", "title", "observed_at", "source", "confidence"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "kind": {
      "type": "string",
      "enum": ["earthquake", "flood", "wildfire", "storm", "landslide", "infrastructure", "medical", "security", "other"]
    },
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "default": ""},
    "observed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "severity": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.5},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "official": {"type": "boolean", "default": false},
    "geometry": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": {"type": "string", "enum": ["Point"]},
            "coordinates": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {"type": "number", "minimum": -180, "maximum": 180},
                {"type": "number", "minimum": -90, "maximum": 90}
              ]
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "area": {"type": ["string", "null"]},
    "source": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string"},
        "type": {"type": "string", "enum": ["cap", "rss", "json", "field", "sim", "other"]},
        "url": {"type": ["string", "null"]},
        "source_id": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "weight"],
        "properties": {
          "source": {"type": "string"},
          "weight": {"type": "number", "minimum": 0, "maximum": 1},
          "note": {"type": "string"}
        },
        "additionalProperties": true
      },
      "default": []
    },
    "raw": {"type": ["object", "string", "null"]},
    "tags": {"type": "array", "items": {"type": "string"}, "default": []}
  },
  "additionalProperties": true
}

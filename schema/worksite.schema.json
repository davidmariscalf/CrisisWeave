{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crisisweave.local/schema/worksite.schema.json",
  "title": "CrisisWeave Volunteer Worksite",
  "description": "A concrete recovery work request. Worksites are explicit operational records and must never be inferred automatically from hazard incidents.",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "title", "status", "priority", "work_types", "area", "request_origin", "updated_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "area": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": ["unassigned", "assigned", "in_progress", "completed", "on_hold"]
    },
    "priority": {
      "type": "string",
      "enum": ["urgent", "high", "normal", "low"]
    },
    "work_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["muck_out", "debris_removal", "tree_removal", "chainsaw", "tarp", "roof", "mold_remediation", "accessibility", "other"]
      }
    },
    "people_needed": {"type": "integer", "minimum": 1},
    "required_skills": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "safety_notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"const": "Point"},
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {"type": "number", "minimum": -180, "maximum": 180},
            {"type": "number", "minimum": -90, "maximum": 90}
          ]
        }
      }
    },
    "location_precision": {
      "type": "string",
      "enum": ["area", "approximate", "exact"]
    },
    "request_origin": {
      "type": "string",
      "enum": ["survivor_request", "coordinator", "field_assessment", "demo"]
    },
    "consent_to_share": {"type": "boolean"},
    "organization": {"type": "string"},
    "instructions": {"type": "string"},
    "updated_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "source_id": {"type": "string"},
        "url": {"type": "string", "format": "uri"}
      }
    }
  }
}
